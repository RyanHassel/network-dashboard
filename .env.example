# ==============================================================================
# NetDash Runtime Environment Configuration (.env)
# Generated automatically by install-netdash.sh or copied from .env.example
# ==============================================================================

# --- Database (TimescaleDB / PostgreSQL 16) ---
POSTGRES_USER=netdash
POSTGRES_PASSWORD=changeme_strong_db_password
POSTGRES_DB=netdash

# Connection strings used inside Docker bridge network (api, vector)
DATABASE_URL=postgresql://netdash:changeme_strong_db_password@timescaledb:5432/netdash
SYNC_DATABASE_URL=postgresql://netdash:changeme_strong_db_password@timescaledb:5432/netdash

# --- Redis (Pub/Sub & Live Metric Cache) ---
REDIS_URL=redis://redis:6379/0

# --- UniFi Dream Machine Pro (UDM Pro) Telemetry ---
UNIFI_HOST=192.168.1.1
UNIFI_API_KEY=your_unifi_network_integration_api_key
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false
UNIFI_POLL_INTERVAL=30

# --- Asynchronous SNMP Poller ---
# Supported versions: v2c or v3
SNMP_VERSION=v2c
SNMP_COMMUNITY=public
# Comma-separated list of target device IPs/hostnames (up to 50 devices)
SNMP_TARGETS=192.168.1.1,192.168.1.2
SNMP_PORT=161
SNMP_POLL_INTERVAL=60
SNMP_RAW_RETENTION_DAYS=180

# Optional SNMPv3 credentials (used when SNMP_VERSION=v3)
SNMP_V3_USER=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_PRIV_PROTOCOL=AES

# --- Allowed-Subnet Network Scanner (<10 Subnets) ---
# Comma-separated IPv4 CIDRs to sweep via Nmap + ARP/UniFi correlation
ALLOWED_SUBNETS=192.168.1.0/24,10.0.10.0/24
SUBNET_SCAN_MINUTES=15

# --- Remote Syslog Ingestion (Vector -> TimescaleDB) ---
SYSLOG_PORT=514
LOG_RETENTION_DAYS=30

# --- Web Dashboard & Reverse Proxy ---
WEB_PORT=8080
