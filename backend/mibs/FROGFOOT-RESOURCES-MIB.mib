FROGFOOT-RESOURCES-MIB DEFINITIONS ::= BEGIN
IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, Gauge32, enterprises
        FROM SNMPv2-SMI;

resources MODULE-IDENTITY
    LAST-UPDATED "200407170000Z"
    ORGANIZATION "Frogfoot Networks"
    CONTACT-INFO "support@frogfoot.net"
    DESCRIPTION  "Embedded Linux Memory and Load Average MIB (used by Ubiquiti, OpenWrt, Embedded Linux)."
    ::= { enterprises 10002 1 1 1 }

memory            OBJECT IDENTIFIER ::= { resources 1 }
load              OBJECT IDENTIFIER ::= { resources 4 }

memTotal OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Total usable physical RAM in KB"
    ::= { memory 1 }

memFree OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Free physical RAM in KB"
    ::= { memory 2 }

memBuffer OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Buffer memory in KB"
    ::= { memory 3 }

memCache OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Page cache memory in KB"
    ::= { memory 4 }

END
